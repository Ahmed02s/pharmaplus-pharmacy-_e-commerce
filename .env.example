VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key
# demo = no Paystack popup, paystack_test = Paystack test popup, paystack_live = server-verified live payments
VITE_PAYMENT_MODE=paystack_test
VITE_STRIPE_PUBLIC_KEY=your_stripe_public_key

# Optional real Paystack verification secrets, set with:
# supabase secrets set PAYSTACK_SECRET_KEY=sk_test_xxx SUPABASE_SERVICE_ROLE_KEY=xxx
PAYSTACK_SECRET_KEY=your_paystack_secret_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
